# Server Environment Variables

# Database
DATABASE_URL="postgresql://vello:vello_password@localhost:5432/vello_db"

# JWT Secrets — CHANGE THESE IN PRODUCTION
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production"

# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated list of allowed origins
CORS_ORIGINS="http://localhost:8081,exp://localhost:8081"

# Object Storage (legacy S3-compatible — unused when Supabase is configured)
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Supabase Storage (production media uploads)
# SUPABASE_URL is the project API URL (e.g. https://<ref>.supabase.co)
SUPABASE_URL="https://<ref>.supabase.co"
# SUPABASE_SECRET_KEY is the service_role key (Settings → API → service_role)
SUPABASE_SECRET_KEY="your-supabase-service-role-key"
# SUPABASE_STORAGE_URL is the dedicated Storage hostname
# e.g. https://<ref>.storage.supabase.co
SUPABASE_STORAGE_URL="https://<ref>.storage.supabase.co"
# Bucket name (must exist in Supabase Storage and have public access enabled)
SUPABASE_STORAGE_BUCKET="chatrio-media"

# Expo push notifications
EXPO_ACCESS_TOKEN=""
